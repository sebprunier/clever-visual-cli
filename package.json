{
  "name": "clever-visual-cli",
  "version": "0.1.0",
  "description": "A visual interface for clever-tools, the Clever Cloud CLI, with a few extras; front-end only, built on @clevercloud/client",
  "license": "Apache-2.0",
  "author": "Sébastien Prunier",
  "homepage": "https://sebprunier.github.io/clever-visual-cli/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebprunier/clever-visual-cli.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "spike:node": "node scripts/spike-node.mjs",
    "dev:cli": "CVC_DEV_PROFILE=1 vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@clevercloud/client": "12.6.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitepress": "1.6.4",
    "vitest": "5.0.5"
  }
}
