{
  "name": "clever-visual-cli",
  "version": "0.1.0",
  "description": "Une console Clever Cloud alternative, 100 % front, batie sur @clevercloud/client",
  "license": "Apache-2.0",
  "author": "Sébastien Prunier",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "spike:node": "node scripts/spike-node.mjs",
    "dev:cli": "CVC_DEV_PROFILE=1 vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@clevercloud/client": "12.6.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
}
